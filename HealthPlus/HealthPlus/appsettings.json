{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=HealthPlusDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "HealthPlus@SuperSecretKey#2024!ChangeInProd",
    "Issuer": "HealthPlus",
    "Audience": "HealthPlusClients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4201" ]
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "SenderEmail": "",
    "SenderName": "HealthPlus",
    "Username": "",
    "Password": ""
  },
  "Firebase": {
    "CredentialsPath": "firebase-service-account.json"
  },
  "Google": {
    "ClientId": "852027992399-b0mduibbtpapqpvg3pakr69f40jvggjc.apps.googleusercontent.com"
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "FromPhoneNumber": ""
  },
  "AiChat": {
    "Provider": "Gemini",
    "ApiKey": "",
    "Model": "gemini-flash-latest",
    "MaxTokens": 1024
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/healthplus-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}
