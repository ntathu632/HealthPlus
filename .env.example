# Copy this file to .env before running `docker compose up` — docker-compose loads
# .env automatically from the same folder. .env itself should NOT be committed to git.

# SQL Server "sa" password. MSSQL requires 8+ chars with upper+lower+digit+special.
SQL_SA_PASSWORD=HealthPlus@Docker2024!

# JWT signing key — change this to a long random string for anything beyond local testing.
JWT_SECRET_KEY=HealthPlus@Docker#SuperSecretKey2024!ChangeMe

# Development keeps Swagger UI enabled at /swagger. Use Production for a real deployment.
ASPNETCORE_ENVIRONMENT=Development

# Optional — real email/push notifications. Leave blank to keep them gracefully disabled
# (see PROGRESS.md → "Cấu hình Notification thật" for how to obtain these).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_SENDER=
EMAIL_USERNAME=
EMAIL_PASSWORD=
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# Optional — real SMS reminders via Twilio. Leave blank to keep SMS gracefully disabled
# (see PROGRESS.md → "Cấu hình SMS thật" for how to obtain these).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE_NUMBER=
